# ==== Secrets - ne jamais committer, chmod 600 sur le fichier .env reel ====

# Admin initial (cree au premier demarrage uniquement)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@example.com

# PostgreSQL - le mot de passe sert au conteneur postgres ET a l'application
DB_PASSWORD=
POSTGRES_DB=accounting
POSTGRES_USER=accounting

# Extraction IA - le provider est choisi par utilisateur, defaut Claude
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Falco / Peppol - uniquement si FALCO_ENABLED=true
FALCO_API_KEY=
FALCO_APP_SECRET=

# ==== Configuration non sensible ====

# UID/GID proprietaire des fichiers ecrits dans /data/uploads
# Doit correspondre au proprietaire du dossier hote monte a cet endroit
# Recuperer les valeurs sur l'hote avec: id -u && id -g
PUID=1000
PGID=10

# Modeles IA
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
GEMINI_MODEL=gemini-2.5-flash

# Peppol desactive par defaut: les beans Falco ne sont pas crees
FALCO_ENABLED=false
FALCO_BASE_URL=https://api.sandbox.falco-app.be/v1

# Inbox scannee
INBOX_ENABLED=true
INBOX_DIR=./inbox

# CORS - origine du frontend
CORS_ALLOWED_ORIGINS=http://localhost:4200

# false en dev (http), true derriere HTTPS
SESSION_COOKIE_SECURE=false
